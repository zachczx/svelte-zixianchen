# Public browser project token (phc_...), never a PostHog personal API key.
# Astro embeds these at build time; configure them in the hosting build environment.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://phz.zixianchen.com
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Optional localhost-only survey testing with pnpm dev. Never reuse the production token.
# These cannot enable surveys on preview deployments or production builds on localhost.
PUBLIC_POSTHOG_TEST_MODE=false
PUBLIC_POSTHOG_TEST_KEY=
